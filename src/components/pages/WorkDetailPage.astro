---
import { getCollection, getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { sortWorks, getWorkHref } from '../../lib/works';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  workId: string;
}

const { locale, workId } = Astro.props;
const t = useTranslations(locale);

const work = await getEntry('works', workId);
if (!work) throw new Error(`Work not found: ${workId}`);

const categoriesRaw = await getCollection('categories');
const categories = categoriesRaw
  .sort((a, b) => a.data.order - b.data.order)
  .map((c) => ({ slug: c.id, label: locale === 'ru' ? c.data.label_ru : c.data.label_en }));

const allWorks = await getCollection('works');
const isStandalone = !work.data.category;

const categoryLabel = isStandalone
  ? t('video.title')
  : (categories.find((c) => c.slug === work.data.category)?.label ?? work.data.category);

const backHref = isStandalone
  ? getRelativeLocaleUrl(locale, '/video')
  : `${getRelativeLocaleUrl(locale, '/portfolio')}#${work.data.category}`;

const siblingWorks = isStandalone
  ? sortWorks(allWorks.filter((w) => w.data.medium === 'video'))
  : sortWorks(allWorks.filter((w) => w.data.category === work.data.category));

const currentIndex = siblingWorks.findIndex((w) => w.id === work.id);
const nextWork = siblingWorks.length > 1 ? siblingWorks[(currentIndex + 1) % siblingWorks.length] : null;
const nextHref = nextWork ? getWorkHref(locale, nextWork) : null;

const currentPage = isStandalone ? 'video' : 'portfolio';
const path = isStandalone ? `/video/${work.id}` : `/portfolio/${work.data.category}/${work.id}`;

const title = locale === 'ru' ? work.data.title_ru : work.data.title_en;
const description = locale === 'ru' ? work.data.description_ru : work.data.description_en;

const pageTitle = `${title} — Anna Cher`;
const pageDescription = description ?? categoryLabel;
---

<BaseLayout
  locale={locale}
  currentPage={currentPage}
  path={path}
  title={pageTitle}
  description={pageDescription}
  categories={categories}
>
  <div class="work-topbar">
    <a class="work-nav-btn" href={backHref}>← {t('work.back')}</a>
    {nextHref && <a class="work-nav-btn" href={nextHref}>{t('work.next')} →</a>}
  </div>

  <div class="work-head">
    <p class="index-label"><span class="title">{categoryLabel}</span></p>
    <h1 class="work-title">{title}</h1>
    {work.data.client && <p class="work-client">{t('card.client')} {work.data.client}</p>}
    {description && <p class="work-description">{description}</p>}
  </div>

  <div class="work-gallery">
    {work.data.video && (
      <video
        class="work-video"
        src={work.data.video}
        controls
        muted={!work.data.hasAudio}
        autoplay={!work.data.hasAudio}
        loop={!work.data.hasAudio}
        playsinline
      />
    )}
    {work.data.images.length > 0
      ? work.data.images.map((img) => (
          <Image src={img} alt={title} width={1400} class={img.width > img.height ? 'work-photo-wide' : undefined} />
        ))
      : !work.data.video && <div class="work-placeholder">{t('work.noMedia')}</div>}
  </div>
</BaseLayout>
