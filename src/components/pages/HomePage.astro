---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../WorkCard.astro';
import { useTranslations } from '../../i18n/utils';
import { sortWorks, getWorkHref } from '../../lib/works';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const categoriesRaw = await getCollection('categories');
const categories = categoriesRaw
  .sort((a, b) => a.data.order - b.data.order)
  .map((c) => ({ slug: c.id, label: locale === 'ru' ? c.data.label_ru : c.data.label_en }));

const allWorks = await getCollection('works');
const recentWorks = sortWorks(allWorks.filter((w) => w.data.featured)).slice(0, 4);

const portfolioHref = getRelativeLocaleUrl(locale, '/portfolio');

const title = locale === 'ru' ? 'Anna Cher — AI-художник и бренд-дизайнер' : 'Anna Cher — AI Artist and Brand Designer';
const description =
  locale === 'ru'
    ? 'Куратированное портфолио AI-artist и бренд-дизайнера Анны Черновой: ювелирка, одежда, косметика.'
    : 'Curated portfolio of AI artist and brand designer Anna Cher: jewelry, clothing, cosmetics.';
---

<BaseLayout locale={locale} currentPage="home" path="/" title={title} description={description} categories={categories}>
  <div class="hero section-block">
    <h1>ANNA CHER</h1>
    <p class="role">{t('hero.role')}</p>
  </div>

  <div class="section-block works-wrap" id="works-anchor">
    <p class="link-label">{t('home.recentWorks')}</p>
    <div class="works-strip">
      {recentWorks.map((work) => (
        <WorkCard work={work} locale={locale} linkHref={getWorkHref(locale, work)} />
      ))}
    </div>
  </div>

  <a class="portfolio-banner" href={portfolioHref}>
    <span>{t('home.portfolioBanner')}</span>
  </a>

  <div class="section-block about-wrap" id="about-anchor">
    <div class="about-layout">
      <div class="portrait">
        <img src="/images/anna-portrait.jpg" alt="Anna Chernova" width="563" height="563" />
      </div>
      <div class="about-text">
        <p class="block-heading">{t('home.about')}</p>
        <p>{t('home.aboutText')}</p>
        <div class="clients-block">
          <p class="block-heading">{t('home.clients')}</p>
          <p class="list">{t('home.clientsList')}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section-block contacts-wrap" id="contact-anchor">
    <div class="contacts-inner">
      <p class="block-heading">{t('home.contacts')}</p>
      <ul class="contact-list">
        <li><a href="mailto:annacheraicreator@gmail.com"><span>Email</span>annacheraicreator@gmail.com</a></li>
        <li><a href="https://t.me/annacher2023" target="_blank" rel="noopener"><span>Telegram</span>@annacher2023</a></li>
        <li><a href="https://pinterest.com/anna_cher_24" target="_blank" rel="noopener"><span>Pinterest</span>@anna_cher_24</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
