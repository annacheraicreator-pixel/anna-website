---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  dark?: boolean;
}

const { locale, dark = false } = Astro.props;
const t = useTranslations(locale);
---

<footer class="site-footer" class:list={[{ dark }]}>
  <p>{t('footer.rights')}</p>
</footer>
