---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  currentPage: 'home' | 'portfolio' | 'video';
  path: string;
  title: string;
  description: string;
  categories: { slug: string; label: string }[];
}

const { locale, currentPage, path, title, description, categories } = Astro.props;

const enPath = getRelativeLocaleUrl('en', path);
const ruPath = getRelativeLocaleUrl('ru', path);
const canonicalPath = locale === 'en' ? enPath : ruPath;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).toString()} />
  <link rel="alternate" hreflang="ru" href={new URL(ruPath, Astro.site).toString()} />
  <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site).toString()} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Encode+Sans+Expanded:wght@400;500;600;700&family=Stack+Sans+Headline:wght@300;400&family=Stack+Sans+Notch:wght@400&display=swap"
    rel="stylesheet"
  />
  <!-- Google only serves Latin glyphs for these families by default; this forces the same font files to also cover Cyrillic, so RU and EN render with identical weight/size instead of RU falling back to the system font. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Encode+Sans+Expanded:wght@400;500;600;700&family=Stack+Sans+Headline:wght@300;400&family=Stack+Sans+Notch:wght@400&text=%D0%90%D0%91%D0%92%D0%93%D0%94%D0%95%D0%81%D0%96%D0%97%D0%98%D0%99%D0%9A%D0%9B%D0%9C%D0%9D%D0%9E%D0%9F%D0%A0%D0%A1%D0%A2%D0%A3%D0%A4%D0%A5%D0%A6%D0%A7%D0%A8%D0%A9%D0%AA%D0%AB%D0%AC%D0%AD%D0%AE%D0%AF%D0%B0%D0%B1%D0%B2%D0%B3%D0%B4%D0%B5%D1%91%D0%B6%D0%B7%D0%B8%D0%B9%D0%BA%D0%BB%D0%BC%D0%BD%D0%BE%D0%BF%D1%80%D1%81%D1%82%D1%83%D1%84%D1%85%D1%86%D1%87%D1%88%D1%89%D1%8A%D1%8B%D1%8C%D1%8D%D1%8E%D1%8F%C2%AB%C2%BB%E2%80%94&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <Header locale={locale} currentPage={currentPage} categories={categories} />
  <main>
    <slot />
  </main>
  <Footer locale={locale} dark={currentPage === 'home'} />
</body>
</html>
